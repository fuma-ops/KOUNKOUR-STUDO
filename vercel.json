{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/radar/backfill-details.ts": {
      "maxDuration": 60
    },
    "api/radar/scrape-live.ts": {
      "maxDuration": 60
    },
    "api/radar/fetch-docs.ts": {
      "maxDuration": 60
    },
    "api/alerts/daily.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?path=/sitemap.xml"
    },
    {
      "source": "/:path((?!api/|assets/|images/|icons/|annales/|sw\\.js|manifest\\.webmanifest).*)",
      "destination": "/api/seo?path=/:path"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
