{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/radar/backfill-details.ts": {
      "maxDuration": 60
    },
    "api/radar/scrape-live.ts": {
      "maxDuration": 60
    },
    "api/radar/fetch-docs.ts": {
      "maxDuration": 60
    },
    "api/alerts/daily.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?path=/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?path=/sitemap.xml"
    },
    {
      "source": "/:path((?!api/|assets/|images/).*)",
      "destination": "/api/seo?path=/:path"
    }
  ]
}
